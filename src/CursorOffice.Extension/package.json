{
  "name": "cursor-office",
  "displayName": "Cursor Office",
  "description": "A local 3D office visualization for Cursor agents.",
  "version": "0.1.49",
  "private": true,
  "publisher": "cursor-office",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mediel/CursorOffice.git"
  },
  "engines": {
    "vscode": "^1.103.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:cursorOffice.openOffice",
    "onCommand:cursorOffice.installGlobalHooks",
    "onCommand:cursorOffice.uninstallGlobalHooks"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorOffice.openOffice",
        "title": "Open Office",
        "category": "Cursor Office"
      },
      {
        "command": "cursorOffice.selectOfficeLogo",
        "title": "Select Office Logo",
        "category": "Cursor Office"
      },
      {
        "command": "cursorOffice.installGlobalHooks",
        "title": "Install Global Hooks",
        "category": "Cursor Office"
      },
      {
        "command": "cursorOffice.uninstallGlobalHooks",
        "title": "Uninstall Global Hooks",
        "category": "Cursor Office"
      }
    ],
    "configuration": {
      "title": "Cursor Office",
      "properties": {
        "cursorOffice.ownerName": {
          "type": "string",
          "default": "",
          "scope": "window",
          "order": 10,
          "markdownDescription": "Owner nickname shown in the office. Leave empty to use the local user name."
        },
        "cursorOffice.ownerAppearance.hairStyle": {
          "type": "string",
          "enum": [
            "executive",
            "sidePart",
            "short",
            "buzz",
            "bob",
            "long",
            "curly",
            "bun",
            "mohawk",
            "bald"
          ],
          "enumItemLabels": [
            "Executive",
            "Side part",
            "Short",
            "Buzz cut",
            "Bob",
            "Long",
            "Curly",
            "Bun",
            "Mohawk",
            "Bald"
          ],
          "default": "executive",
          "scope": "application",
          "order": 11,
          "markdownDescription": "Office owner hairstyle."
        },
        "cursorOffice.ownerAppearance.hairColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#3d281f",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "scope": "application",
          "order": 12,
          "markdownDescription": "Owner hair and facial-hair color."
        },
        "cursorOffice.ownerAppearance.skinColor": {
          "type": "string",
          "format": "color-hex",
          "default": "#e8b991",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "scope": "application",
          "order": 13,
          "markdownDescription": "Owner skin tone."
        },
        "cursorOffice.ownerAppearance.facialHair": {
          "type": "string",
          "enum": [
            "none",
            "stubble",
            "mustache",
            "soulPatch",
            "goatee",
            "anchor",
            "fullBeard",
            "muttonChops",
            "sideburns"
          ],
          "enumItemLabels": [
            "None",
            "Stubble",
            "Mustache",
            "Soul patch",
            "Goatee",
            "Anchor",
            "Full beard",
            "Mutton chops",
            "Sideburns"
          ],
          "default": "none",
          "scope": "application",
          "order": 14,
          "markdownDescription": "Owner facial-hair style."
        },
        "cursorOffice.ownerAppearance.eyewear": {
          "type": "string",
          "enum": [
            "none",
            "glasses",
            "sunglasses"
          ],
          "enumItemLabels": [
            "None",
            "Glasses",
            "Sunglasses"
          ],
          "default": "none",
          "scope": "application",
          "order": 15,
          "markdownDescription": "Owner eyewear."
        },
        "cursorOffice.officeName": {
          "type": "string",
          "default": "Cursor Office",
          "scope": "application",
          "order": 20,
          "markdownDescription": "Custom name shown in the office header and editor tab."
        },
        "cursorOffice.officeLogoPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 22,
          "markdownDescription": "Absolute path to a custom PNG, JPEG, WebP, or GIF logo (max. 2 MB). Empty or invalid paths use the office-name initials. You can also use `Cursor Office: Select Office Logo`."
        },
        "cursorOffice.language": {
          "type": "string",
          "enum": [
            "auto",
            "cs",
            "en"
          ],
          "enumItemLabels": [
            "Automatic (Windows)",
            "Czech",
            "English"
          ],
          "default": "auto",
          "scope": "application",
          "order": 30,
          "markdownDescription": "Office UI language. Automatic mode uses Czech on Czech Windows and English for English or any unsupported language."
        },
        "cursorOffice.shirtColors.owner": {
          "type": "string",
          "format": "color-hex",
          "default": "#32c477",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "patternErrorMessage": "Use a color in #RRGGBB format.",
          "scope": "application",
          "order": 40,
          "markdownDescription": "Owner shirt color."
        },
        "cursorOffice.shirtColors.manager": {
          "type": "string",
          "format": "color-hex",
          "default": "#00c7c7",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "patternErrorMessage": "Use a color in #RRGGBB format.",
          "scope": "application",
          "order": 50,
          "markdownDescription": "Cursor window manager shirt color."
        },
        "cursorOffice.shirtColors.chat": {
          "type": "string",
          "format": "color-hex",
          "default": "#2f6bff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "patternErrorMessage": "Use a color in #RRGGBB format.",
          "scope": "application",
          "order": 60,
          "markdownDescription": "Main chat or senior-agent shirt color."
        },
        "cursorOffice.shirtColors.subagent": {
          "type": "string",
          "format": "color-hex",
          "default": "#b084ff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "patternErrorMessage": "Use a color in #RRGGBB format.",
          "scope": "application",
          "order": 70,
          "markdownDescription": "Subagent or worker shirt color."
        },
        "cursorOffice.hud.showModel": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 80,
          "markdownDescription": "Show the Hook-provided model in the list, inspector, and 3D label. Enabled by default."
        },
        "cursorOffice.hud.showTokens": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 81,
          "markdownDescription": "Show evidenced generation usage and context-window fill. Missing values are never shown as zero."
        },
        "cursorOffice.hud.showActivity": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 82,
          "markdownDescription": "Show the agent's current activity (tool, analysis, file, or subagent task). Prompt text is never shown."
        },
        "cursorOffice.hostPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 100,
          "markdownDescription": "Optional absolute path to `CursorOffice.Host.dll`, a `.csproj`, or a local host executable. Leave empty for automatic discovery."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "package:vsix": "vsce package --no-dependencies",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.103.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
